# Default profile: Meta's Llama API (multimodal Maverick).
# Get a key from Meta's Llama developer portal, then paste it below.
LLM_API_KEY=paste_your_llama_api_key_here

# Optional overrides:
# LLM_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
# PORT=8000

# --- Alternative profiles (comment out LLM_API_KEY above, use one below) ---
# Hugging Face Inference Providers (legacy HF_TOKEN alias also works):
# LLM_BASE_URL=https://router.huggingface.co/v1/chat/completions
# LLM_API_KEY=hf_paste_your_token_here
# LLM_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct
#
# Ollama Cloud (key from https://ollama.com/settings/keys, vision model):
# LLM_BASE_URL=https://ollama.com/v1/chat/completions
# LLM_API_KEY=paste_your_ollama_key_here
# LLM_MODEL=gemma4:31b
#
# Local Ollama (no key needed):
# LLM_BASE_URL=http://localhost:11434/v1/chat/completions
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2-vision
